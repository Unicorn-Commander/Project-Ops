generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum ProjectStatus {
  NEW
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  PROCESSING
  VERIFIED
  REJECTED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  MILESTONE
  DELIVERABLE
  REVIEW
  MEETING
  RESEARCH
  OTHER
}

enum TriageStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  APPLIED
  DROPPED
}

enum OrgType {
  AGENCY // An agency or service firm
  BUSINESS // A business client with multiple contacts
  INDIVIDUAL // Individual client
  PARTNER // Partner organization
}

enum ContactMethod {
  EMAIL
  PHONE
  SMS
  PORTAL
}

// ── Time tracking & billing ──────────────────────────────

enum TimeEntrySource {
  TIMER
  MANUAL
  IMPORTED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Scope at which a BillingRate applies. Resolution precedence,
// most-specific first: TASK > TASK_TYPE > PROJECT > CONTACT >
// USER_PROJECT > USER > ROLE > ORG.
enum RateScopeType {
  TASK
  TASK_TYPE
  PROJECT
  CONTACT
  USER_PROJECT
  USER
  ROLE
  ORG
}

enum RoundingMode {
  NONE
  NEAREST
  UP
  DOWN
}

// ── Suite tenancy (SUITE-IDENTITY.md §2) ─────────────────
//
// The canonical suite roles + membership lifecycle. Roles rank
// viewer < member < manager < admin < owner (SUITE-IDENTITY §7).
enum WorkspaceRole {
  VIEWER
  MEMBER
  MANAGER
  ADMIN
  OWNER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// ============================================================
// SUITE TENANCY (SUITE-IDENTITY.md §2 — verbatim)
// ============================================================
//
// Phase 1 of the suite tenancy foundation (PROJ-2026-000023). These two
// models + a nullable `workspaceId` on every tenant-scoped model land the
// DB-enforced tenancy boundary additively: RLS is created-but-inert for the
// running app until the runtime DATABASE_URL is flipped to `project_ops_app`
// (a later phase). Nothing here changes the running app's behavior.

/// Thin mirror of the uc-registry workspace record. PO NEVER mints workspace_id.
model Workspace {
  invitations WorkspaceInvitation[]
  id                String       @id // == uc-registry workspace_id (uuidv7). NO @default.
  slug              String       @unique
  displayName       String
  parentWorkspaceId String?
  isolationMode     String       @default("standard") // 'strict'|'standard'|'open'  (TEXT+CHECK, §5)
  isolationTier     String       @default("shared") // 'shared'|'premium'|'enterprise'|'dedicated'
  hipaaMode         Boolean      @default(false)
  gdprMode          Boolean      @default(false)
  dataResidency     String?      @default("us-east")
  status            String       @default("active") // active|suspended|archived|deleting
  entitlementCache  Json? // offline/dedicated only; null on shared SaaS
  syncedAt          DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  memberships       Membership[]

  @@index([slug])
  @@index([status])
  @@map("workspaces")
}

model Membership {
  userKey     String // == User.keycloakId == uchub sub
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userKey, workspaceId])
  @@index([userKey])
  @@index([workspaceId])
  @@map("memberships")
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String    @unique
  firstName           String
  lastName            String
  role                UserRole  @default(CLIENT)
  keycloakId          String?   @unique
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  password            String?
  forcePasswordChange Boolean?  @default(false)
  // Capacity planning (Wave 2): the user's weekly working-hours budget.
  weeklyCapacityHours Int?      @default(40)
  // Per-user email notification preferences (v1.10): { events: {...}, digest?: ... }.
  // null = defaults. In-app notifications are always on; this gates EMAIL only.
  notificationPreferences Json?

  // Relations - Projects
  assignedProjects Project[] @relation("ProjectAssignee")
  createdProjects  Project[] @relation("ProjectCreator")

  // Relations - Contacts
  createdContacts Contact[] @relation("ContactCreator")
  contactProfile  Contact?  @relation("ContactPortalUser")

  // Relations - Organizations
  organizationsCreated Organization[] @relation("OrganizationCreator")

  // Relations - Organization Contacts
  orgContactsCreated OrganizationContact[] @relation("OrgContactCreator")
  orgContact         OrganizationContact?  @relation("OrgContactUser")

  // Relations - Activity
  comments      Comment[]
  documents     Document[]
  taskComments  TaskComment[] @relation("TaskCommentAuthor")
  assignedTasks Task[]        @relation("TaskAssignee")
  createdTasks  Task[]        @relation("TaskCreator")
  auditLogs     AuditLog[]

  // Relations - Personal Access Tokens (MCP / API access)
  personalAccessTokens PersonalAccessToken[]

  // Relations - Collaboration (Push B)
  notifications Notification[] @relation("UserNotifications")
  savedViews    SavedView[]    @relation("UserSavedViews")

  // Relations - Time tracking
  timeEntries         TimeEntry[]       @relation("TimeEntryUser")
  approvedTimeEntries TimeEntry[]       @relation("TimeEntryApprover")
  timesheetPeriods    TimesheetPeriod[] @relation("TimesheetPeriodUser")
  approvedTimesheets  TimesheetPeriod[] @relation("TimesheetPeriodApprover")
  billingRatesCreated BillingRate[]     @relation("BillingRateCreator")

  @@index([email])
  @@index([keycloakId])
  @@index([role])
  @@map("users")
}

// ============================================================
// PERSONAL ACCESS TOKENS
// ============================================================
//
// Long-lived bearer tokens a user can mint to use Project-Ops with
// their own MCP client (Claude Code, ChatGPT, custom integration)
// without going through the Brigade federation broker.
//
// The plaintext token is shown to the user exactly once at creation
// time and never persisted; only a bcrypt hash is stored. Token
// format: `po_pat_<base64url(32 random bytes)>`. The `po_pat_` prefix
// lets the auth pipeline short-circuit JWT parsing as soon as the
// header lands.
//
// Scopes are stored as plain strings (e.g. "read:projects",
// "write:tasks"). v1 enforces them only on the /api/v1/mcp tool
// dispatch path; other endpoints honor the owning user's full RBAC.
model PersonalAccessToken {
  id         String    @id @default(uuid())
  // Suite tenancy: nullable in Phase 2 (additive). App-enforced (no RLS).
  workspaceId String?
  userId     String
  name       String // human label, e.g. "Claude Code on Aaron's Mac"
  prefix     String    @default("po_pat_")
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime? // null = no expiry (allowed; surface a warning)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([revokedAt])
  @@index([workspaceId])
  @@map("personal_access_tokens")
}

// ============================================================
// ORGANIZATION HIERARCHY
// ============================================================

model Organization {
  id          String  @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  // PO Organization is the operator's CLIENT record, NEVER the tenancy
  // boundary — that is `workspaceId`. (SUITE-IDENTITY §2.)
  workspaceId String
  name        String
  type        OrgType
  taxId       String? // EIN or identifier

  // Business information
  industry      String?
  website       String?
  annualRevenue Decimal? @db.Decimal(15, 2)
  employeeCount Int?

  // Address
  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("USA")

  // Hierarchy (self-referential for multi-level structure)
  parentOrgId String?
  parentOrg   Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childOrgs   Organization[] @relation("OrgHierarchy")

  // Primary Contact
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("OrganizationPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  // Portal & Access
  portalAccessEnabled Boolean @default(false)
  isActive            Boolean @default(true)

  // Metadata
  notes    String? @db.Text
  metadata Json?

  // Relationships
  organizationContacts OrganizationContact[]
  contacts             Contact[]             @relation("OrganizationContacts")
  projects             Project[]

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("OrganizationCreator", fields: [createdById], references: [id])

  @@index([type])
  @@index([parentOrgId])
  @@index([isActive])
  @@index([createdById])
  @@index([name])
  @@index([taxId])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("organizations")
}

model OrganizationContact {
  id String @id @default(uuid())

  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId String

  // Personal information
  firstName   String
  lastName    String
  email       String  @unique
  phone       String?
  mobilePhone String?
  title       String?
  department  String?

  // Organization link
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Portal access (optional - not all contacts need login)
  userId String? @unique
  user   User?   @relation("OrgContactUser", fields: [userId], references: [id], onDelete: SetNull)

  // Contact preferences
  isPrimaryContact       Boolean        @default(false)
  portalAccessEnabled    Boolean        @default(false)
  preferredContactMethod ContactMethod? @default(EMAIL)
  notificationsEnabled   Boolean        @default(true)

  // Metadata
  notes    String? @db.Text
  metadata Json?

  // Audit
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("OrgContactCreator", fields: [createdById], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([userId])
  @@index([isPrimaryContact])
  @@index([lastName])
  @@index([workspaceId])
  @@map("organization_contacts")
}

model Contact {
  id          String  @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId String
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  taxId       String?
  notes       String?
  isActive    Boolean @default(true)

  // Organization link
  organizationId String?
  organization   Organization? @relation("OrganizationContacts", fields: [organizationId], references: [id], onDelete: SetNull)
  primaryOrgOf   Organization? @relation("OrganizationPrimaryContact")

  // Portal access
  userId              String?   @unique
  portalAccessEnabled Boolean   @default(false)
  invitationSentAt    DateTime?
  invitationToken     String?   @unique

  // Relationships
  projects Project[]

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("ContactCreator", fields: [createdById], references: [id])
  user        User?    @relation("ContactPortalUser", fields: [userId], references: [id])

  @@unique([workspaceId, email])
  @@index([email])
  @@index([lastName])
  @@index([company])
  @@index([organizationId])
  @@index([createdById])
  @@index([workspaceId])
  @@map("contacts")
}

model Project {
  id            String          @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId   String
  // projectNumber is unique PER WORKSPACE (see @@unique below), not globally.
  projectNumber String
  title         String
  description   String?
  clientDescription String?
  status        ProjectStatus   @default(NEW)
  priority      ProjectPriority @default(MEDIUM)
  category      String?
  tags          Json?

  // Contact information
  clientName  String
  clientEmail String?
  clientPhone String?
  contactId   String?

  // Organization link
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Timeline
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Assignment
  createdById  String
  assignedToId String?

  // Billing & Invoicing
  invoiceNumber       String?
  billingAmount       Decimal?       @db.Decimal(10, 2)
  amountPaid          Decimal?       @default(0.00) @db.Decimal(10, 2)
  paymentStatus       PaymentStatus? @default(UNPAID)
  billingDate         DateTime?
  paymentDueDate      DateTime?
  paymentReceivedDate DateTime?
  billingNotes        String?

  // Flat fee is the price the operator set. billingAmount is overwritten with
  // the invoice total when an invoice is issued, so it is not the source.
  flatFeeAmount         Decimal?  @db.Decimal(12, 2)
  flatFeeInvoicedAt     DateTime?
  // Suite ids. contactId stays the local Project-Ops contact.
  customerOpsCustomerId String?
  contactOpsContactId   String?

  // Time-tracking & billing policy
  billByDefault            Boolean       @default(true)
  defaultBillRate          Decimal?      @db.Decimal(12, 4)
  budgetHours              Decimal?      @db.Decimal(10, 2)
  budgetAmount             Decimal?      @db.Decimal(12, 2)
  roundingIncrementMinutes Int?
  roundingMode             RoundingMode?

  // Metadata
  metadata Json?

  // Recurrence (Wave 2): RRULE + the template project this instance was spawned from.
  recurrenceRule     String?
  recurrenceParentId String?

  // Relations
  contact         Contact?         @relation(fields: [contactId], references: [id])
  assignedTo      User?            @relation("ProjectAssignee", fields: [assignedToId], references: [id])
  createdBy       User             @relation("ProjectCreator", fields: [createdById], references: [id])
  comments        Comment[]
  documents       Document[]
  tasks           Task[]
  auditLogs       AuditLog[]
  triageProposals TriageProposal[] @relation("TriageProposalProject")
  timeEntries     TimeEntry[]
  approvals       Approval[]
  agentEvents     AgentEvent[]
  recurrenceParent    Project?  @relation("ProjectRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceInstances Project[] @relation("ProjectRecurrence")

  @@unique([workspaceId, projectNumber])
  @@index([status])
  @@index([priority])
  @@index([contactId])
  @@index([organizationId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([paymentStatus])
  @@index([billingDate])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, assignedToId])
  @@index([recurrenceParentId])
  @@map("projects")
}

model Document {
  id           String         @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId  String
  projectId    String?
  uploadedById String
  fileName     String
  fileSize     Int
  mimeType     String
  s3Key        String         @unique
  s3Bucket     String
  isClientVisible Boolean @default(false)
  status       DocumentStatus @default(PENDING)
  description  String?
  tags         String[]
  metadata     Json?
  uploadedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([uploadedById])
  @@index([status])
  @@index([s3Key])
  @@index([workspaceId])
  @@map("documents")
}

model Comment {
  id          String   @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId String
  projectId   String
  authorId    String
  content     String
  isInternal  Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@index([createdAt])
  @@index([workspaceId])
  @@map("comments")
}

model AuditLog {
  id          String      @id @default(uuid())
  // Suite tenancy: INTENTIONALLY nullable (Phase 3 left it so — see
  // 20260617000000_phase3_workspace_not_null). audit_logs is the one scoped
  // table whose write path (AuditService.log) tolerates an unstamped DTO by
  // design: a workspace-less system event (e.g. a future LOGIN/LOGOUT audit, or
  // any pre-workspace-resolution failure) must still be recordable, and the
  // never-throw audit contract would SILENTLY DROP such a row if NOT NULL turned
  // the fallback into a hard PG error. Every current caller stamps workspaceId,
  // so RLS still fences live rows; we keep the column nullable as the safety
  // valve. RLS predicate (workspaceId = current_workspace_id()) already makes a
  // NULL-workspace row invisible/un-writable under a GUC — fail-closed reads.
  workspaceId String?
  userId      String?
  projectId   String?
  action      AuditAction
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime    @default(now())
  project     Project?    @relation(fields: [projectId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([timestamp])
  @@index([workspaceId])
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

model EmailConfig {
  id           String   @id @default(uuid())
  provider     String?
  smtpHost     String
  smtpPort     Int      @default(587)
  smtpSecure   Boolean  @default(false)
  smtpUser     String
  smtpPassword String
  fromName     String
  fromEmail    String
  isEnabled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_config")
}

model Task {
  id           String        @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId  String
  projectId    String
  title        String
  description  String?
  type         TaskType      @default(OTHER)
  status       TaskStatus    @default(PENDING)
  priority     TaskPriority  @default(MEDIUM)
  dueDate      DateTime?
  completedAt  DateTime?
  createdById  String
  assignedToId String?
  parentTaskId String?
  // Recurrence (Wave 2): an RRULE string + the template task this instance was spawned from.
  recurrenceRule     String?
  recurrenceParentId String?
  // Capacity planning (Wave 2): effort estimate used to compute per-user workload.
  estimatedHours     Decimal?      @db.Decimal(8, 2)
  metadata     Json?
  // Time-tracking policy overrides (null = inherit from project)
  billable     Boolean?
  billRate     Decimal?      @db.Decimal(12, 4)
  // Flat fee for this task (quantity 1). Time on a task that has one is not
  // billed hourly. invoicedAt stops the fee from being invoiced twice.
  fixedAmount        Decimal? @db.Decimal(12, 2)
  invoicedAt         DateTime?
  invoiceExternalRef String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  comments     TaskComment[]
  timeEntries  TimeEntry[]
  assignedTo   User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("TaskCreator", fields: [createdById], references: [id])
  parentTask   Task?         @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]        @relation("TaskSubtasks")
  dependsOn    TaskDependency[] @relation("TaskDepSuccessor")
  dependents   TaskDependency[] @relation("TaskDepPredecessor")
  recurrenceParent    Task?  @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceInstances Task[] @relation("TaskRecurrence")

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([createdById])
  @@index([priority])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, assignedToId])
  @@index([parentTaskId])
  @@index([recurrenceParentId])
  @@map("tasks")
}

model TaskComment {
  id          String   @id @default(uuid())
  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId String
  taskId      String
  authorId    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([workspaceId])
  @@map("task_comments")
}

// ============================================================
// COLLABORATION (Push B): task dependencies, notifications, saved views
// ============================================================
// All three are workspace-tenanted (RLS fences on workspaceId via the
// workspace_isolation policy); notifications/saved_views are additionally
// filtered by userId in the query layer (RLS is the tenant fence, not the
// per-user fence). DDL + RLS + grants live in the Push B migration.

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

// A directed dependency: `successor` depends on `predecessor`.
model TaskDependency {
  id            String             @id @default(uuid())
  workspaceId   String
  predecessorId String
  successorId   String
  type          TaskDependencyType @default(FINISH_TO_START)
  createdById   String
  createdAt     DateTime           @default(now())
  predecessor   Task               @relation("TaskDepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task               @relation("TaskDepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([workspaceId])
  @@index([successorId])
  @@map("task_dependencies")
}

// Per-user in-app notification. RLS fences by workspace; the app filters by userId.
model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  type        String
  title       String
  body        String?
  entityType  String?
  entityId    String?
  actorId     String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId, readAt])
  @@index([workspaceId, userId])
  @@map("notifications")
}

// A saved list view (filters/sort/columns) for a user within a workspace.
model SavedView {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  scope       String
  name        String
  config      Json
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("UserSavedViews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, scope])
  @@index([userId])
  @@map("saved_views")
}

// ============================================================
// WAVE 2: automations, custom fields, recurring, webhooks, client approvals
// ============================================================
// All five tables are workspace-tenanted (RLS workspace_isolation on workspaceId
// + DML grant to project_ops_app). Recurrence lives as columns on tasks/projects;
// custom-field VALUES live in the entity's existing `metadata` JSON under a
// `customFields` key (only the DEFINITIONS get a table). DDL + RLS in the Wave-2 migration.

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

enum CustomFieldEntity {
  TASK
  PROJECT
}

// Domain events an AutomationRule can fire on (mapped onto the EventEmitter stream).
enum AutomationTrigger {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_COMPLETED
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  COMMENT_CREATED
}

enum ClientApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ApprovalEntityType {
  DOCUMENT
  DELIVERABLE
  PROJECT
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// A user-defined field for tasks or projects. Values are stored in the entity's
// metadata JSON under `customFields[key]`; only the definition is a row here.
model CustomFieldDefinition {
  id          String            @id @default(uuid())
  workspaceId String
  entity      CustomFieldEntity
  key         String
  label       String
  type        CustomFieldType
  options     Json?
  required    Boolean           @default(false)
  position    Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, entity, key])
  @@index([workspaceId])
  @@index([workspaceId, entity])
  @@map("custom_field_definitions")
}

// A trigger -> conditions -> actions rule run by the automation engine off the EventEmitter.
model AutomationRule {
  id          String            @id @default(uuid())
  workspaceId String
  name        String
  enabled     Boolean           @default(true)
  trigger     AutomationTrigger
  conditions  Json?
  actions     Json
  createdById String
  lastRunAt   DateTime?
  runCount    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, trigger, enabled])
  @@map("automation_rules")
}

// An outbound webhook subscription; HMAC-signed deliveries are logged in WebhookDelivery.
model WebhookEndpoint {
  id          String            @id @default(uuid())
  workspaceId String
  url         String
  secret      String
  events      String[]
  enabled     Boolean           @default(true)
  description String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(uuid())
  workspaceId  String
  endpointId   String
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  attempts     Int                   @default(0)
  error        String?
  createdAt    DateTime              @default(now())
  deliveredAt  DateTime?
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

// A client-portal approval request on a document / deliverable / project.
model Approval {
  id                 String               @id @default(uuid())
  workspaceId        String
  entityType         ApprovalEntityType
  entityId           String
  projectId          String?
  requestedById      String
  approverContactId  String?
  status             ClientApprovalStatus @default(PENDING)
  note               String?
  decisionNote       String?
  decidedByContactId String?
  decidedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([projectId])
  @@map("approvals")
}

// ============================================================
// AGENT ACTIVITY & USAGE LEDGER (v1.11)
// ============================================================
// The agent analog of time entries: one row per agent action taken through the
// automation surfaces (MCP tool call, in-app assistant turn, PAT-authenticated
// API write) — NOT direct human GUI clicks. Captured at the source so token/cost
// can ride along (the assistant knows its own spend; MCP tool-calls are
// zero-cost actions; federated LLM cost is filled from the suite gateway/Lago in
// a later phase). Workspace-tenanted (RLS workspace_isolation + grants). Powers
// the "Agents" views (roster / activity / usage & cost) and, optionally, agent
// billing (costUsd → a billable line via the Accounting-Ops rollup).

enum AgentVia {
  MCP
  API
  ASSISTANT
  GUI
  SYSTEM
}

enum AgentActorKind {
  PAT
  ASSISTANT
  FEDERATED
  USER
  SYSTEM
}

model AgentEvent {
  id          String         @id @default(uuid())
  workspaceId String
  projectId   String?
  taskId      String?
  actorKind   AgentActorKind
  actorKey    String // stable per-agent key: PAT id / "assistant" / federated sub / user id
  actorLabel  String // human-readable ("Claude Code · Field bot", "Project Assistant", "Meeting-Ops")
  via         AgentVia
  action      String // tool name or verb ("create_task", "assistant.turn", "update_project")
  resource    String?
  resourceId  String?
  tokensIn    Int?
  tokensOut   Int?
  costUsd     Decimal?       @db.Decimal(12, 6)
  durationMs  Int?
  billable    Boolean        @default(false)
  details     Json?
  occurredAt  DateTime       @default(now())
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, actorKey])
  @@index([workspaceId, projectId])
  @@map("agent_events")
}

// ============================================================
// TRIAGE AGENT (PO-owned; Meeting-Ops & other sources -> routed tasks)
// ============================================================
//
// One row per candidate action item. The agent proposes (keep / route / dedup);
// nothing becomes a Task until a human approves. The "Unassigned / needs a
// project" inbox is: agentKeep = true AND proposedProjectId = null AND
// dedupeNote = null AND status = PENDING_REVIEW -> from there a user assigns it
// to an existing project or creates a new one (createProjectFromUnassigned).
// Idempotent on (sourceType, sourceActionItemId) so a re-finalized meeting
// never double-proposes.
model TriageProposal {
  id String @id @default(uuid())

  // Suite tenancy: NOT NULL since Phase 3 (20260617000000_phase3_workspace_not_null).
  workspaceId String

  // Source provenance + idempotency
  sourceType         String  @default("MANUAL") // MEETING_OPS | MANUAL | WEBHOOK | IMPORT
  sourceActionItemId String? // stable id from the source (e.g. meeting-ops action_items.id)
  sourceRef          Json?
  rawText            String  @db.Text
  owner              String? // free-text owner from the source (e.g. a diarized speaker label)

  // Agent decision
  agentKeep         Boolean      @default(true)
  proposedProjectId String?
  proposedProject   Project?     @relation("TriageProposalProject", fields: [proposedProjectId], references: [id], onDelete: SetNull)
  proposedTitle     String
  proposedPriority  TaskPriority @default(MEDIUM)
  dedupeNote        String? // set when the agent flags this as a duplicate
  matchScore        Decimal?     @db.Decimal(6, 4)
  alternatives      Json? // other candidate projects, for the reviewer to pick from
  reasoning         String?      @db.Text

  // Review lifecycle
  status          TriageStatus @default(PENDING_REVIEW)
  createdById     String // user the agent acted for
  reviewedById    String?
  rejectionReason String?
  reasonPreset    String?
  duplicateOfTaskId String?
  createdTaskId   String? // Task created on approval (soft link, no FK)
  appliedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, sourceType, sourceActionItemId])
  @@index([status])
  @@index([proposedProjectId])
  @@index([sourceType])
  @@index([createdById])
  @@index([workspaceId])
  @@map("triage_proposals")
}

// ============================================================
// TIME TRACKING & BILLABLE ROLLUP
// ============================================================

// A single block of logged work. The spine of the professional-services
// tier: approved + billable + unbilled entries roll up into an Accounting-Ops
// invoice draft. Money is always Decimal, never float. Entries with lockedAt
// set or billed = true are immutable (enforced in service).
//
// INVARIANT: at most ONE running entry (endedAt IS NULL) per user. Enforced
// in TimerService AND by a partial unique index created in PrismaService
// (Prisma `db push` can't express `WHERE endedAt IS NULL`):
//   CREATE UNIQUE INDEX uq_time_entry_one_running
//     ON "time_entries"("userId") WHERE "endedAt" IS NULL;
model TimeEntry {
  id          String @id @default(uuid())
  workspaceId String

  userId String
  user   User   @relation("TimeEntryUser", fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  description String?

  startedAt              DateTime
  endedAt                DateTime?
  durationSeconds        Int? // raw elapsed seconds, derived on stop
  roundingAppliedSeconds Int? // billable seconds after rounding

  source TimeEntrySource @default(MANUAL)

  billable   Boolean   @default(true)
  billed     Boolean   @default(false)
  invoiceRef String? // AO invoice id once billed
  lockedAt   DateTime? // set when approved-locked or billed -> immutable

  billRateApplied Decimal? @db.Decimal(12, 4)
  costRateApplied Decimal? @db.Decimal(12, 4) // margin only — NEVER exposed to CLIENT
  currency        String   @default("USD")
  billableAmount  Decimal? @db.Decimal(12, 2)

  approvalStatus  ApprovalStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?          @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?

  timesheetPeriodId String?
  timesheetPeriod   TimesheetPeriod? @relation(fields: [timesheetPeriodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([approvalStatus])
  @@index([billable, billed])
  @@index([startedAt])
  @@index([timesheetPeriodId])
  @@map("time_entries")
}

// Bill + cost rates at multiple scopes. Resolution picks the most-specific
// effective rate for (user, project, task, date) — see RateScopeType. Only
// the scope columns relevant to scopeType are populated; the resolver matches
// on them in precedence order. costRate drives margin reporting and is never
// returned on a CLIENT-visible path.
model BillingRate {
  id          String @id @default(uuid())
  workspaceId String

  scopeType      RateScopeType
  userId         String?
  projectId      String?
  contactId      String?
  taskId         String?
  taskType       TaskType?
  role           UserRole?
  organizationId String?

  billRate Decimal  @db.Decimal(12, 4)
  costRate Decimal? @db.Decimal(12, 4) // margin only — NEVER exposed to CLIENT
  currency String   @default("USD")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String
  createdBy   User     @relation("BillingRateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([scopeType])
  @@index([userId])
  @@index([projectId])
  @@index([contactId])
  @@index([taskId])
  @@index([organizationId])
  @@index([effectiveFrom, effectiveTo])
  @@map("billing_rates")
}

// Weekly approval grouping. submit -> SUBMITTED; approve/reject per entry or
// bulk; APPROVED locks entries against edit; REJECTED returns entries to DRAFT
// with a reason.
model TimesheetPeriod {
  id          String @id @default(uuid())
  workspaceId String

  userId String
  user   User   @relation("TimesheetPeriodUser", fields: [userId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  status          ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedById    String?
  approvedBy      User?          @relation("TimesheetPeriodApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?

  entries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId, periodStart])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@map("timesheet_periods")
}

// Identity/control table, guarded by owner authorization and exact-email acceptance.
model WorkspaceInvitation {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  role WorkspaceRole @default(MEMBER)
  tokenHash String @unique
  status String @default("pending")
  createdByKey String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedByKey String?
  acceptedAt DateTime?
  @@index([email, status])
  @@index([workspaceId])
  @@map("workspace_invitations")
}
