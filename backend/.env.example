# Database Configuration
DATABASE_URL=postgresql://[USERNAME]:REMOVED@postgres:5432/northbridgetax?schema=public

# Application Configuration
NODE_ENV=production
PORT=3101

# JWT Secret - Generate with: openssl rand -base64 64
JWT_SECRET=[GENERATE_STRONG_SECRET_64_BYTES]

# CORS Configuration
CORS_ORIGIN=https://cpas.taxsq.com
FRONTEND_URL=https://cpas.taxsq.com

# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=northbridgetax
KEYCLOAK_CLIENT_ID=northbridgetax-backend
KEYCLOAK_CLIENT_SECRET=[GENERATE_STRONG_SECRET]

# MinIO Object Storage - Internal configuration (Docker network)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=[GENERATE_ACCESS_KEY]
MINIO_SECRET_KEY=[GENERATE_STRONG_SECRET]
MINIO_BUCKET=northbridgetax-documents

# MinIO - Public configuration (for presigned URLs accessible from browsers)
MINIO_PUBLIC_ENDPOINT=storage.cpas.taxsq.com
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# Email Configuration (Optional - for SendGrid integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NorthbridgeTax CPA

# Email Encryption Key - Generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=[GENERATE_HEX_KEY_32_BYTES]
