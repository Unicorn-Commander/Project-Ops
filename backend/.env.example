# =====================================================================
# Project Ops — Backend environment template
# Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database ---
DATABASE_URL=postgresql://project_ops_admin:REMOVED@project-ops-postgres:5432/project_ops?schema=public

# --- Application ---
NODE_ENV=production
PORT=3201
LOG_LEVEL=info

# --- JWT (local sessions for client-portal users) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRATION=3600

# --- CORS / Frontend URL ---
# Set to the public hostname of the frontend deployment.
CORS_ORIGIN=https://projectops.magicunicorn.dev
FRONTEND_URL=https://projectops.magicunicorn.dev

# --- Keycloak SSO (uchub realm on auth.unicorncommander.ai) ---
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=project-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]

# --- MinIO (internal docker network) ---
MINIO_ENDPOINT=project-ops-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=projectops
MINIO_SECRET_KEY=[GENERATE_STRONG_SECRET]
MINIO_BUCKET=project-ops-documents

# --- MinIO public (for browser-presigned URLs) ---
MINIO_PUBLIC_ENDPOINT=storage.projectops.magicunicorn.dev
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# --- Redis ---
REDIS_HOST=project-ops-redis
REDIS_PORT=6379
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Project Ops
SMTP_FROM_ADDRESS=noreply@magicunicorn.tech

# Email field encryption key (for stored SMTP credentials, etc.).
# Generate: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=[GENERATE_HEX_32_BYTE_KEY]
