# =====================================================================
# Project Ops — Backend environment template
# Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database ---
# RUNTIME connection: the app MUST connect as the NOBYPASSRLS role
# `project_ops_app` so Postgres Row-Level Security actually enforces workspace
# isolation. Connecting as a BYPASSRLS owner (e.g. project_ops_admin) silently
# defeats RLS. When PROJECT_OPS_TENANCY_ENABLED=true the app refuses to boot if
# its live role has BYPASSRLS (startup self-check in DbRoleGuardService).
DATABASE_URL=postgresql://project_ops_app:REMOVED@project-ops-postgres:5432/project_ops?schema=public

# ADMIN/owner connection — BYPASSRLS, used ONLY for schema work (migrations /
# `prisma db push` / role + RLS-policy creation), NEVER by the running app.
# Point prisma's migrate/db-push commands at this; keep it out of the app env.
# DATABASE_ADMIN_URL=postgresql://project_ops_admin:REMOVED@project-ops-postgres:5432/project_ops?schema=public

# --- Application ---
NODE_ENV=production
PORT=3201
LOG_LEVEL=info

# --- JWT (local sessions for client-portal users) ---
# Generate: openssl rand -base64 64
# REQUIRED in production. When NODE_ENV=production the app refuses to boot if
# this is unset or weaker than 32 chars (env validation in app.config.ts).
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRATION=3600

# --- CORS / Frontend URL ---
# Set to the public hostname of the frontend deployment.
CORS_ORIGIN=https://projectops.magicunicorn.dev
FRONTEND_URL=https://projectops.magicunicorn.dev

# --- Keycloak SSO (uchub realm on auth.unicorncommander.ai) ---
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=project-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]

# Realm-token audience binding (cross-app fence).
# The uchub realm is SHARED across every UC app, so a realm RS256 token minted
# for a SIBLING client (accounting-ops, meeting-ops, …) verifies against the
# same JWKS. With enforcement ON, PO additionally requires the token's
# `azp` (authorized party) OR `aud` (audience) to match an accepted client id.
#   KEYCLOAK_ENFORCE_AUDIENCE   default true. Set 'false' ONLY as a temporary
#                               escape hatch if dogfood tokens are unexpectedly
#                               rejected (then inspect the real azp/aud — see
#                               below — and add it to the allow-list instead).
#   KEYCLOAK_EXPECTED_AUDIENCES CSV of additional accepted azp/aud values. The
#                               PO KEYCLOAK_CLIENT_ID is ALWAYS accepted; this
#                               only adds more (e.g. a separate public client).
# NOTE: Keycloak's DEFAULT token layout puts the client in `azp` and only
# `account` in `aud`, so a real PO token usually looks like
# { azp: "project-ops", aud: "account" } — which this passes via the azp match.
# VERIFY what YOUR realm emits before tightening: decode a live PO access token
# (jwt.io, or: cut -d. -f2 <<<"$TOKEN" | base64 -d | jq '{azp,aud}') and confirm
# azp/aud. If your realm puts a different value in azp, add it here.
KEYCLOAK_ENFORCE_AUDIENCE=true
KEYCLOAK_EXPECTED_AUDIENCES=project-ops

# --- MinIO (internal docker network) ---
MINIO_ENDPOINT=project-ops-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=projectops
MINIO_SECRET_KEY=[GENERATE_STRONG_SECRET]
MINIO_BUCKET=project-ops-documents

# --- MinIO public (for browser-presigned URLs) ---
MINIO_PUBLIC_ENDPOINT=storage.projectops.magicunicorn.dev
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# --- Redis ---
REDIS_HOST=project-ops-redis
REDIS_PORT=6379
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Project Ops
SMTP_FROM_ADDRESS=noreply@magicunicorn.tech

# Email field encryption key (for stored SMTP credentials, etc.).
# Generate: openssl rand -hex 32   (must be exactly 64 hex chars = 32 bytes)
# REQUIRED in production: a stored SMTP password is encrypted under this key, so
# a random per-process fallback would make it undecryptable after restart. When
# NODE_ENV=production the app refuses to boot if this is unset/malformed.
EMAIL_ENCRYPTION_KEY=[GENERATE_HEX_32_BYTE_KEY]

# --- Brigade (embedded "Project Ops Assistant" outbound, optional) ---
# The assistant proxies chat to a Brigade agent. BRIGADE_API_KEY must be a
# Brigade X-API-Key minted for the BRIGADE_AGENT_ID agent. For the consumer
# billing wall to treat Project-Ops as a paid first-party service (no 402
# "out of credits"), the key's NAME must be listed in Brigade's
# BRIGADE_TRUSTED_KEY_NAMES (mint the key named "project-ops").
# Leave BRIGADE_API_KEY blank to disable the assistant.
BRIGADE_URL=https://brigade.magicunicorn.dev
BRIGADE_API_KEY=
BRIGADE_AGENT_ID=project-ops-assistant

# --- uc-registry (Phase E — suite workspace source of record) ---
# OPTIONAL. When UNSET (the dogfood/default), PO's uc-registry client is a pure
# no-op and workspace creation behaves exactly as today (PO holds the local
# mirror alone). When SET, every workspace-creation path (the seed scripts; any
# future workspace-CRUD-create) registers the workspace with uc-registry,
# supplying PO's canonical uuid + an Idempotency-Key so the registry (SoR) and
# PO's local mirror always agree on the same id. See docs/PHASE-E-PROD-RUNBOOK.md
# for the prod cutover (reachability + the hard gate before the prod RLS flip).
# UC_REGISTRY_URL=http://127.0.0.1:8081
# UC_REGISTRY_TIMEOUT_MS=5000

# --- Ops-Center entitlement gate (replaces the SSO allowlist when armed) ---
# OPTIONAL + OFF by default. When NOT armed, SSO sign-in is governed by the
# static PROJECT_OPS_ACCESS_LIST above (exactly today's behavior). The gate is
# ARMED only when PROJECT_OPS_ENTITLEMENTS_ENABLED is truthy AND UC_ENTITLEMENTS_URL
# is set — an "enabled-but-no-URL" misconfig stays inert (falls back to the
# allowlist) rather than locking everyone out. When armed, the interactive SSO
# login forwards the user's uchub Bearer to UC_ENTITLEMENTS_URL and allows iff
# the org carries PROJECT_OPS_FEATURE_KEY; the JIT role is seeded from the org
# role (owner->ADMIN, else->STAFF). Re-checked on every interactive login.
# PROJECT_OPS_ENTITLEMENTS_ENABLED=false
# UC_ENTITLEMENTS_URL=                      # e.g. https://api.unicorncommander.ai/api/v1/entitlements (from UC dev)
# PROJECT_OPS_FEATURE_KEY=project_ops_access
# UC_ENTITLEMENTS_TIMEOUT_MS=5000
# On an indeterminate result (endpoint outage/timeout): false (default) fails
# CLOSED = deny; true degrades to the PROJECT_OPS_ACCESS_LIST allowlist.
# PROJECT_OPS_ENTITLEMENTS_FAIL_OPEN=false

# --- Triage agent inference endpoints (LAN defaults) ---
# Embeddings + reranking served by Infinity; chat/vision by Qwen (OpenAI-compatible).
# Defaults point at on-LAN hosts; override per deployment.
INFINITY_EMBEDDINGS_URL=http://192.168.10.14:8082
INFINITY_RERANK_URL=http://192.168.10.14:8083
QWEN_URL=http://192.168.10.68:8088/v1/chat/completions
QWEN_MODEL=Qwen3.6-35B-A3B-Vision
INFINITY_EMBED_MODEL=BAAI/bge-m3
INFINITY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
