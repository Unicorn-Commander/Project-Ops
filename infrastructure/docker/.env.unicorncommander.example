# Project-Ops PROD env — commander / unicorncommander.ai
# Copy to `.env` next to docker-compose.unicorncommander.yml ON COMMANDER ONLY.
# Real values are host-only + gitignored. This .example is the canonical checklist.

# --- Public hosts (must have DNS A/CNAME -> commander) ---
DOMAIN=projectops.unicorncommander.ai
API_DOMAIN=api.projectops.unicorncommander.ai
STORAGE_DOMAIN=garage.unicorncommander.ai          # the shared Garage/MinIO public endpoint

# --- Database ---
POSTGRES_DB=project_ops
POSTGRES_USER=project_ops_admin                     # OWNER (runs migrations/DDL)
POSTGRES_PASSWORD=__set_strong__
# Runtime app role for the RLS flip (see THE FLIP below). Until the flip,
# leave these unset so the backend connects as the owner.
# PO_DB_USER=project_ops_app                         # NOBYPASSRLS
# PO_DB_PASSWORD=__set_strong__

# --- Core secrets ---
REDIS_PASSWORD=__set_strong__
JWT_SECRET=__openssl_rand_hex_32__
EMAIL_ENCRYPTION_KEY=__openssl_rand_hex_32__        # backend refuses to boot without it

# --- Keycloak (uchub prod client `project-ops`) ---
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=project-ops
KEYCLOAK_CLIENT_SECRET=__from_uchub_client__         # the new uchub prod client's secret
# KEYCLOAK_EXPECTED_AUDIENCES=                        # extend only if the token's aud/azp != project-ops

# --- Object storage (shared Garage S3) ---
MINIO_ENDPOINT=unicorn-garage
MINIO_PORT=3900
MINIO_APP_USER=projectops
MINIO_APP_PASSWORD=__from_garage__

# --- uc-registry (Source of Record — key now persisted by the suite dev) ---
UC_REGISTRY_URL=http://uc-ops-center-uc-registry-1:8081

# --- Assistant (Brigade) ---
BRIGADE_URL=https://brigade.magicunicorn.dev         # the broker the project-ops-assistant agent lives on
BRIGADE_API_KEY=__brigade_service_key__
BRIGADE_AGENT_ID=project-ops-assistant
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai

# --- Access / federation ---
PROJECT_OPS_ACCESS_LIST=                             # who can JIT-provision + at what role (CSV rules)
PROJECT_OPS_FEDERATION_ACTORS=                       # trusted sibling apps for triage ingest (CSV)

# --- Billing (LIVE at launch — Aaron's decision) ---
BILLABLE_ROLLUP_LIVE=true

# --- Misc ---
NODE_ENV=production
ENABLE_SWAGGER=false
DEFAULT_WORKSPACE_ID=019e50a3-d995-723f-ab66-0f765f92c0f4

# === FIRST BOOT — schema + RLS ===
# postgres first-boot runs 01-init.sql (creates the roles incl. the NOBYPASSRLS
# project_ops_app, with PLACEHOLDER passwords + the extensions/grants). Then apply
# the FULL migrations as the OWNER — `prisma migrate deploy` (NOT `prisma db push`,
# which syncs the schema model but SKIPS the custom RLS / policy / grant SQL that
# lives in the migration files). The backend's schema_drift boot check confirms
# completeness. (scripts/deploy.sh uses db push — do NOT use it for the prod flip.)
#
# === THE FLIP (after schema+RLS are applied + the registry is verified) ===
# 1. Rotate the runtime role's placeholder password, as the owner:
#      ALTER ROLE project_ops_app PASSWORD '<strong>';     (+ audit/ro if used)
# 2. Set here:  PO_DB_USER=project_ops_app   PO_DB_PASSWORD=<that same strong value>
# 3. Set here:  PROJECT_OPS_TENANCY_ENABLED=true   — then recreate the backend.
# The backend boot self-check REFUSES to start if tenancy is on while the runtime
# role can still bypass RLS — the safety net. Verify a workspace creation registers
# in uc-registry + RLS isolation across two tenants before declaring GA.
