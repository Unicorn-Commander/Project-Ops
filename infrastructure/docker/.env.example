# =====================================================================
# Project Ops — Docker compose environment template
# Copy to .env in this directory. Never commit .env.
#
# Used by docker-compose.yml. The frontend/backend containers also read
# from their respective ../../<service>/.env at build/runtime, but compose
# substitutes ${VAR} from this file for image build args + container env.
# =====================================================================

# --- Domain (override per-deployment) ---
# Bigboy / internal:    projectops.magicunicorn.dev
# Future SaaS:          projectops.unicorncommander.ai
DOMAIN=projectops.magicunicorn.dev
API_DOMAIN=api.projectops.magicunicorn.dev
STORAGE_DOMAIN=storage.projectops.magicunicorn.dev
STORAGE_CONSOLE_DOMAIN=console.storage.projectops.magicunicorn.dev

# --- Postgres ---
POSTGRES_USER=project_ops_admin
POSTGRES_PASSWORD=[GENERATE_STRONG_PASSWORD]
POSTGRES_DB=project_ops

# --- Redis ---
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=[GENERATE_STRONG_PASSWORD]
MINIO_APP_USER=projectops
MINIO_APP_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- Keycloak (uchub realm on auth.unicorncommander.ai) ---
KEYCLOAK_CLIENT_ID=project-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]
# Maximum accepted lifetime for Keycloak realm tokens. 0 disables this check.
KEYCLOAK_MAX_TOKEN_LIFETIME_SECONDS=86400

# --- JWT (local-only sessions, e.g. client-portal) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRATION=3600

# --- App config ---
NODE_ENV=production
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENVIRONMENT=production
BUILD_TARGET=production

# --- Frontend build args (injected at next.js build time) ---
NEXT_PUBLIC_API_URL=https://${API_DOMAIN}/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.unicorncommander.ai

# --- Unicorn Brigade (assistant chat backend) ---
BRIGADE_URL=https://brigade.magicunicorn.dev
BRIGADE_API_KEY=[FROM_BRIGADE_ADMIN_OR_SERVICE_KEY]
BRIGADE_AGENT_ID=project-ops-assistant

# --- SSO access list (added v1.6.24) ---
# Comma-separated email-or-pattern : role pairs. Decides who can
# JIT-provision a Project-Ops account from the shared uchub Keycloak realm
# AND what role they land at. Without this var, a legacy fallback admits
# only Aaron + Shafen as ADMIN and rejects everyone else (logged at boot).
# Domain wildcards: *@magicunicorn.tech:STAFF
# Roles: ADMIN, MANAGER, STAFF, CLIENT
PROJECT_OPS_ACCESS_LIST=aaron@magicunicorn.tech:ADMIN,shafenkhan@users.noreply.github.com:ADMIN,*@magicunicorn.tech:STAFF

# --- Ops-Center entitlement gate (the launch-gate replacement for the allowlist above) ---
# OFF by default; the PROJECT_OPS_ACCESS_LIST above governs until this is armed.
# Armed only when ENABLED is truthy AND UC_ENTITLEMENTS_URL is set (an
# enabled-but-no-URL deploy stays inert on the allowlist). When armed, SSO login
# forwards the user's uchub Bearer to the endpoint and allows iff the org carries
# PROJECT_OPS_FEATURE_KEY; JIT role from the org role (owner->ADMIN, else->STAFF).
# Set URL + key from the UC dev's spec, then flip ENABLED=true to cut over.
# PROJECT_OPS_ENTITLEMENTS_ENABLED=false
# UC_ENTITLEMENTS_URL=
# PROJECT_OPS_FEATURE_KEY=project_ops_access
# PROJECT_OPS_ENTITLEMENTS_FAIL_OPEN=false   # indeterminate => false: deny (closed); true: fall back to allowlist
# Soft-enforce: on a DEFINITIVE deny, grandfather allowlist users in (migration aid; gate still denies non-allowlisted).
# PROJECT_OPS_ENTITLEMENTS_ALLOWLIST_FALLBACK=false

# --- Default workspace (suite tenancy) ---
# Suite-canonical Magic Unicorn workspace id (shared with Meeting-Ops + Contact-Ops; pre-uc-registry).
DEFAULT_WORKSPACE_ID=019e50a3-d995-723f-ab66-0f765f92c0f4

# --- Federation actors (added v1.8.0) ---
# Comma-separated allow-list of TRUSTED sibling-app client-ids that may push to
# the propose-only /api/v1/triage/ingest endpoint via a Brigade token-exchange
# (the app's id is the Brigade token's act.client_id). Such a call sets the
# tenant from the Brigade-vouched workspace_id claim WITHOUT a human membership
# (the rest of the suite federates the same way). Narrow by construction: only
# these actors, only the triage ingest route, propose-only. DEFAULT EMPTY =
# zero federation trust (safe). End-user membership-gating (D5) is unaffected.
# Requires the token to be Brigade-signed + aud=project-ops (already enforced).
# PROJECT_OPS_FEDERATION_ACTORS=meeting-ops
PROJECT_OPS_FEDERATION_ACTORS=

# --- Error tracking (Sentry / Glitchtip) ---
# Optional — leave empty to disable. SDKs are a no-op when DSN is unset.
# In production both point at self-hosted Glitchtip at glitchtip.magicunicorn.dev.
# Glitchtip uses Sentry-protocol DSNs; the public_key is the UUID with hyphens
# stripped (use ProjectKey.get_dsn() inside Glitchtip to get the canonical form).
# SENTRY_DSN_BACKEND=https://YOUR_HEX_KEY@glitchtip.magicunicorn.dev/BACKEND_PROJECT_ID
# SENTRY_DSN_FRONTEND=https://YOUR_HEX_KEY@glitchtip.magicunicorn.dev/FRONTEND_PROJECT_ID
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload to self-hosted Glitchtip. Build-time only — the
# token is consumed by the Sentry webpack plugin during `npm run build`
# and not baked into the runtime image. Generate via Glitchtip's
# /profile/auth-tokens (or Django shell + apps.api_tokens.models).
# SENTRY_AUTH_TOKEN=YOUR_GLITCHTIP_AUTH_TOKEN
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://glitchtip.magicunicorn.dev

# --- Helpers ---
# Generate strong values:
#   passwords: openssl rand -base64 32
#   JWT:       openssl rand -base64 64
#   hex keys:  openssl rand -hex 32
