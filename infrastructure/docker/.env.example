# Self-host configuration (also linked from the repository root .env.example).
# Copy to .env at the REPOSITORY ROOT, then use docker-compose.selfhost.yml.
# Local admin mode needs no edits and no external identity service.
# Database passwords, JWT_SECRET, EMAIL_ENCRYPTION_KEY and DEFAULT_WORKSPACE_ID
# are generated once in the selfhost_config Docker volume, never in this file.
# Bootstrap credentials are displayed only by the interactive command in README.
PROJECT_OPS_AUTH_MODE=local

# Optional OIDC via your own Keycloak server. Set mode=oidc, configure ALL of
# these values, and rebuild to enable the SSO button. Register this callback:
# http://127.0.0.1:3201/api/v1/auth/keycloak/callback
# No realm, URL, client or client secret is supplied by this repository.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# First-login allowlist, e.g. owner@example.com:ADMIN,*@example.com:STAFF.
# Blank in self-host mode is replaced by the generated bootstrap identity.
# Outside the self-host entrypoint, an unset/blank list grants no access.
PROJECT_OPS_ACCESS_LIST=

# Optional S3-compatible storage. Core projects/tasks and local sign-in work
# without it; attachments require a reachable service and these credentials.
# MINIO_PUBLIC_* must address that service from the operator's browser too.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=project-ops-documents
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
