# Database Configuration
POSTGRES_USER=northbridgetax_admin
POSTGRES_PASSWORD=[GENERATE_STRONG_PASSWORD]
POSTGRES_DB=northbridgetax
DATABASE_URL=postgresql://northbridgetax:REMOVED@postgres:5432/northbridgetax

# Keycloak Configuration
KEYCLOAK_ADMIN_PASSWORD=[GENERATE_STRONG_PASSWORD]
KEYCLOAK_DB_PASSWORD=[GENERATE_STRONG_PASSWORD]
BACKEND_KEYCLOAK_CLIENT_ID=northbridgetax-backend
BACKEND_KEYCLOAK_CLIENT_SECRET=[GENERATE_STRONG_SECRET]
FRONTEND_KEYCLOAK_CLIENT_ID=northbridgetax-frontend

# MinIO Configuration
MINIO_ROOT_PASSWORD=[GENERATE_STRONG_PASSWORD]
MINIO_APP_PASSWORD=[GENERATE_STRONG_PASSWORD]

# Redis Configuration
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# Temporal Configuration
TEMPORAL_DB_PASSWORD=[GENERATE_STRONG_PASSWORD]

# JWT Secret - Generate with: openssl rand -base64 64
JWT_SECRET=[GENERATE_STRONG_SECRET_64_BYTES]

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=[GENERATE_STRONG_PASSWORD]
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=[GENERATE_STRONG_SECRET]

# Application Configuration
NODE_ENV=production
PORT=3101
FRONTEND_PORT=3100

# Domain Configuration
DOMAIN=cpas.taxsq.com
KEYCLOAK_HOSTNAME=auth.cpas.taxsq.com
NEXT_PUBLIC_API_URL=https://api.cpas.taxsq.com/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.cpas.taxsq.com
MINIO_DOMAIN=storage.cpas.taxsq.com
CORS_ORIGIN=https://cpas.taxsq.com

# Instructions:
# 1. Copy this file to .env
# 2. Replace all [PLACEHOLDER] values with strong passwords
# 3. Use these commands to generate secure credentials:
#    - Passwords: openssl rand -base64 32
#    - JWT Secret: openssl rand -base64 64
#    - Email Key: openssl rand -hex 32
# 4. NEVER commit the .env file to git
