# =====================================================================
# Project Ops — Docker compose environment template
# Copy to .env in this directory. Never commit .env.
#
# Used by docker-compose.yml. The frontend/backend containers also read
# from their respective ../../<service>/.env at build/runtime, but compose
# substitutes ${VAR} from this file for image build args + container env.
# =====================================================================

# --- Domain (override per-deployment) ---
# Bigboy / internal:    projectops.magicunicorn.dev
# Future SaaS:          projectops.unicorncommander.ai
DOMAIN=projectops.magicunicorn.dev
API_DOMAIN=api.projectops.magicunicorn.dev
STORAGE_DOMAIN=storage.projectops.magicunicorn.dev
STORAGE_CONSOLE_DOMAIN=console.storage.projectops.magicunicorn.dev

# --- Postgres ---
POSTGRES_USER=project_ops_admin
POSTGRES_PASSWORD=[GENERATE_STRONG_PASSWORD]
POSTGRES_DB=project_ops

# --- Redis ---
REDIS_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=[GENERATE_STRONG_PASSWORD]
MINIO_APP_USER=projectops
MINIO_APP_PASSWORD=[GENERATE_STRONG_PASSWORD]

# --- Keycloak (uchub realm on auth.unicorncommander.ai) ---
KEYCLOAK_CLIENT_ID=project-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]

# --- JWT (local-only sessions, e.g. client-portal) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRATION=3600

# --- App config ---
NODE_ENV=production
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENVIRONMENT=production
BUILD_TARGET=production

# --- Frontend build args (injected at next.js build time) ---
NEXT_PUBLIC_API_URL=https://${API_DOMAIN}/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.unicorncommander.ai

# --- Helpers ---
# Generate strong values:
#   passwords: openssl rand -base64 32
#   JWT:       openssl rand -base64 64
#   hex keys:  openssl rand -hex 32
