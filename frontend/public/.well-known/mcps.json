{
  "$schema": "https://brigade.unicorncommander.ai/.well-known/mcps-schema-v1.json",
  "name": "Project-Ops",
  "version": "1.6.59",
  "mcp_endpoint": "https://api.projectops.magicunicorn.dev",
  "tool_namespace": "project",
  "auth": {
    "type": "pat",
    "prefix": "po_pat_",
    "mint_url": "https://projectops.magicunicorn.dev/dashboard/settings",
    "available_scopes": [
      "read:projects",
      "write:projects",
      "read:tasks",
      "write:tasks",
      "read:documents",
      "write:documents",
      "read:activity",
      "read:organizations",
      "write:organizations",
      "write:billing",
      "read:time",
      "write:time"
    ],
    "federated_auth": {
      "type": "brigade_jwt",
      "trusted_issuer": "https://brigade.unicorncommander.ai",
      "jwks_url": "https://brigade.unicorncommander.ai/.well-known/jwks.json",
      "expected_audience": "project-ops",
      "signing_algorithm": "RS256"
    }
  },
  "tools": [
    {
      "name": "list_my_projects",
      "description": "List the projects the calling user can see, newest first. Optional status filter (NEW, IN_PROGRESS, UNDER_REVIEW, COMPLETED, ARCHIVED, ON_HOLD).",
      "input_schema": { "type": "object", "properties": { "status": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } },
      "scopes_required": ["read:projects"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 200
    },
    {
      "name": "get_project",
      "description": "Fetch a single project by id (UUID) or project number (P-XXXXX), including client, billing, and assignment fields the caller may see.",
      "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] },
      "scopes_required": ["read:projects"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 200
    },
    {
      "name": "search_projects",
      "description": "Keyword search across the caller's projects (title, client name, description).",
      "input_schema": { "type": "object", "properties": { "query": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }, "required": ["query"] },
      "scopes_required": ["read:projects"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 300
    },
    {
      "name": "create_project",
      "description": "Create a new project. Auto-assigns the next project number. Defaults: status NEW, priority MEDIUM, assignee = caller. CLIENT-role users cannot call this.",
      "input_schema": { "type": "object", "properties": { "title": { "type": "string", "maxLength": 200 }, "clientName": { "type": "string", "maxLength": 200 }, "clientEmail": { "type": "string" }, "description": { "type": "string" }, "priority": { "type": "string" }, "projectType": { "type": "string" }, "dueDate": { "type": "string", "description": "ISO date or datetime" }, "organizationId": { "type": "string" }, "assignedToId": { "type": "string" } }, "required": ["title", "clientName"] },
      "scopes_required": ["write:projects"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 500
    },
    {
      "name": "update_project_status",
      "description": "Move a project to a new status (NEW, IN_PROGRESS, UNDER_REVIEW, COMPLETED, ARCHIVED, ON_HOLD).",
      "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" } }, "required": ["id", "status"] },
      "scopes_required": ["write:projects"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "update_billing_fields",
      "description": "Update a project's billing and invoicing fields (invoice number, amounts, payment status, billing dates, notes).",
      "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "invoiceNumber": { "type": "string" }, "billingAmount": { "type": "number" }, "amountPaid": { "type": "number" }, "paymentStatus": { "type": "string" }, "billingDate": { "type": "string" }, "paymentDueDate": { "type": "string" }, "billingNotes": { "type": "string" } }, "required": ["id"] },
      "scopes_required": ["write:billing"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "list_my_tasks",
      "description": "List tasks assigned to or visible to the caller. Optional status and project filters.",
      "input_schema": { "type": "object", "properties": { "status": { "type": "string" }, "projectId": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } },
      "scopes_required": ["read:tasks"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 200
    },
    {
      "name": "create_task",
      "description": "Create a task under a project. Requires projectId (UUID). Optional type, status, priority, dueDate, assignee.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "type": { "type": "string" }, "status": { "type": "string" }, "priority": { "type": "string" }, "dueDate": { "type": "string" }, "assignedToId": { "type": "string" } }, "required": ["projectId", "title"] },
      "scopes_required": ["write:tasks"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 500
    },
    {
      "name": "update_task_status",
      "description": "Move a task to a new status (PENDING, IN_PROGRESS, WAITING_FOR_CLIENT, COMPLETED, CANCELLED).",
      "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" } }, "required": ["id", "status"] },
      "scopes_required": ["write:tasks"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "add_task_comment",
      "description": "Add a comment to a task on the caller's behalf.",
      "input_schema": { "type": "object", "properties": { "taskId": { "type": "string" }, "content": { "type": "string" } }, "required": ["taskId", "content"] },
      "scopes_required": ["write:tasks"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "submit_candidate_action_items",
      "description": "Submit a batch of candidate action items (e.g. extracted from a meeting transcript) for triage into tasks. Each item carries the action text plus optional owner and source linkage.",
      "input_schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" }, "owner": { "type": "string" }, "sourceActionItemId": { "type": "string" } }, "required": ["text"] } }, "sourceType": { "type": "string" } }, "required": ["items"] },
      "scopes_required": ["write:tasks"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 500
    },
    {
      "name": "list_project_documents",
      "description": "List documents attached to a project.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" } }, "required": ["projectId"] },
      "scopes_required": ["read:documents"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 250
    },
    {
      "name": "get_document_content",
      "description": "Fetch the extracted text content of a project document.",
      "input_schema": { "type": "object", "properties": { "documentId": { "type": "string" } }, "required": ["documentId"] },
      "scopes_required": ["read:documents"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 350
    },
    {
      "name": "upload_document",
      "description": "Upload a document to a project. Stored in the project-ops-documents bucket.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "filename": { "type": "string" }, "contentBase64": { "type": "string" } }, "required": ["projectId", "filename", "contentBase64"] },
      "scopes_required": ["write:documents"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 1200
    },
    {
      "name": "get_recent_activity",
      "description": "Return the caller's recent activity across projects and tasks (audit feed).",
      "input_schema": { "type": "object", "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } },
      "scopes_required": ["read:activity"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 250
    },
    {
      "name": "start_timer",
      "description": "Start a running work timer for the caller on a project or task. Stops any existing running timer first.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "taskId": { "type": "string" }, "description": { "type": "string" } } },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "stop_timer",
      "description": "Stop the caller's running timer. Computes duration, rounding, rate, and billable amount.",
      "input_schema": { "type": "object", "properties": {} },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "log_time",
      "description": "Log a manual time entry. Provide startedAt+endedAt, startedAt+durationMinutes, endedAt+durationMinutes, or durationMinutes. Identify by projectId or taskId.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "taskId": { "type": "string" }, "description": { "type": "string" }, "startedAt": { "type": "string" }, "endedAt": { "type": "string" }, "durationMinutes": { "type": "number" }, "billable": { "type": "boolean" } } },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 500
    },
    {
      "name": "update_time_entry",
      "description": "Update a DRAFT, unlocked, unbilled time entry (id required). Locked/billed entries are immutable.",
      "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "description": { "type": "string" }, "taskId": { "type": "string" }, "startedAt": { "type": "string" }, "endedAt": { "type": "string" }, "durationMinutes": { "type": "number" }, "billable": { "type": "boolean" } }, "required": ["id"] },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 450
    },
    {
      "name": "list_time_entries",
      "description": "List visible time entries, newest first, paginated. Filters: userId, projectId, taskId, from, to, billable, billed, approvalStatus. CLIENT never sees cost rates.",
      "input_schema": { "type": "object", "properties": { "userId": { "type": "string" }, "projectId": { "type": "string" }, "taskId": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "billable": { "type": "boolean" }, "billed": { "type": "boolean" }, "approvalStatus": { "type": "string" }, "page": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 } } },
      "scopes_required": ["read:time"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 250
    },
    {
      "name": "submit_timesheet",
      "description": "Submit the caller's weekly DRAFT entries for approval (week containing periodStart; default this week).",
      "input_schema": { "type": "object", "properties": { "periodStart": { "type": "string" } } },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 400
    },
    {
      "name": "approve_time",
      "description": "Approve a submitted period (timesheetPeriodId) or specific entries (timeEntryIds). Locks approved entries. MANAGER/ADMIN only.",
      "input_schema": { "type": "object", "properties": { "timesheetPeriodId": { "type": "string" }, "timeEntryIds": { "type": "array", "items": { "type": "string" } } } },
      "scopes_required": ["write:time"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 450
    },
    {
      "name": "get_utilization",
      "description": "Billable vs total hours per user over an optional period (from/to). Optionally narrow to one userId.",
      "input_schema": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "userId": { "type": "string" } } },
      "scopes_required": ["read:time"],
      "tier_required": "free",
      "read_only": true,
      "expected_latency_ms": 350
    },
    {
      "name": "create_billable_draft",
      "description": "Roll up APPROVED, billable, unbilled time for a projectId or clientId into invoice line items and (when Accounting-Ops is connected + entitled) create the invoice idempotently; otherwise return a draft + PDF preview. MANAGER/ADMIN only.",
      "input_schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "clientId": { "type": "string" }, "periodStart": { "type": "string" }, "periodEnd": { "type": "string" }, "groupBy": { "type": "string" }, "autoSend": { "type": "boolean" } } },
      "scopes_required": ["write:billing"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 1500
    },
    {
      "name": "sync_invoice_status",
      "description": "Pull invoice status (sent/partial/paid/overdue) from Accounting-Ops for billed entries and mirror it onto the linked projects.",
      "input_schema": { "type": "object", "properties": {} },
      "scopes_required": ["write:billing"],
      "tier_required": "free",
      "read_only": false,
      "expected_latency_ms": 1500
    }
  ],
  "resources": [
    { "uri_template": "projects://list", "description": "Overview of the caller's projects" },
    { "uri_template": "projects://{project_id}", "description": "Single project with tasks and documents" }
  ],
  "rate_limits": {
    "per_user_per_minute": 60,
    "per_user_per_hour": 1000
  },
  "contact": "aaron@magicunicorn.tech"
}
